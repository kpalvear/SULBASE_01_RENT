# Modo B: no copies a mano — usa `pnpm run prepare:local-auth` desde `.env`.
# Modo A (sin login): copia a `.dev.vars` y descomenta AUTH_DEV_BYPASS sin JWT secret.
#
# Wrangler carga `.dev.vars` en `wrangler dev`.
# Usa el pooler de transacciones de Supabase (puerto 6543), no el 5432 de migraciones.
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase → Project Settings → API → JWT Secret (validates Bearer tokens in the Worker)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Optional: keep single-tenant dev without login (only when SUPABASE_JWT_SECRET is unset)
# AUTH_DEV_BYPASS="true"

# firma.dev — API key y secreto del webhook. Nunca en el cliente ni en git.
# Producción: wrangler secret put FIRMA_API_KEY y wrangler secret put FIRMA_WEBHOOK_SECRET
# Webhook HTTPS: https://rent.sulbase.com/api/webhooks/firma
# (lab, mientras el dominio no esté: https://rent.sistemas-d5d.workers.dev/api/webhooks/firma)
# Debe responder en menos de 5 segundos. El Worker ya confirma y archiva el PDF después.
# Opcional aquí o en .env (prepare:local-auth las copia a .dev.vars si existen):
# FIRMA_API_KEY="your-firma-api-key"
# FIRMA_WEBHOOK_SECRET="your-firma-webhook-secret"
