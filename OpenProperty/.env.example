# ==========================================
# 1. BASE DE DATOS (Supabase + Drizzle)
# ==========================================
# Connection String directa para migraciones (drizzle-kit generate / push)
# Usar el puerto 5432 o la conexión Session Pooler / Directa de Supabase
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Connection String con Pooling de transacciones (Puerto 6543)
# Usar en Worker (`wrangler secret put DATABASE_URL` / `.dev.vars`) y cuando no haya Hyperdrive
DATABASE_POOLED_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ==========================================
# 2. SUPABASE AUTH & APIS
# ==========================================
# URL del proyecto Supabase
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
 
# Key pública/anónima (segura para usar en el frontend)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Vite (frontend) — mismos valores URL + anon key
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Key de servicio con privilegios administrativos (SOLO Backend / Cloudflare Workers - NUNCA al frontend)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# JWT Secret para validación local de tokens de sesión
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"


# ==========================================
# 3. EXPERIMENTO: JEV (TypeSafe AI) - Sección 6.1
# ==========================================
# Clave API para el experimento de clasificación de órdenes de trabajo en Workers
JEV_API_KEY="jev_sk_test_..."
JEV_API_URL="https://api.jev.ai/v1" # Ajustar a la URL oficial del proveedor